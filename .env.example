# Neon Serverless PostgreSQL Database URL (isolated schema 'food_dispenser' is appended automatically)
DATABASE_URL="postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Admin Dashboard Authentication Credentials
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="YourStrongSecurePasswordHere"

# Cryptographic Secret Key for HMAC-SHA256 Session Cookies
SESSION_SECRET="your-super-secret-random-32-byte-hex-key"
